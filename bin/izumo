#!/usr/bin/env bash
# izumo shim: runs the izumo binary for this system, downloading it from the GitHub release
# on first use and checking it against the release's checksums.
# https://github.com/migueww/izumo (MIT)
set -euo pipefail

VERSION=1.0.0
RELEASES=${IZUMO_RELEASES:-https://github.com/migueww/izumo/releases/download}

# the binary reads .izumo with bash: this one, not whatever bash PATH holds (WSL's, on Windows)
export IZUMO_BASH=$BASH
# under Git Bash's terminal the binary sees a pipe, so tell it when someone can answer
if [ -t 0 ]; then export IZUMO_TTY=1; else export IZUMO_TTY=0; fi

case $(uname -s) in
  Linux) os=linux;;
  Darwin) os=darwin;;
  MINGW*|MSYS*|CYGWIN*) os=windows IZUMO_BASH=$(cygpath -m "$BASH");;
  *) echo "izumo: no build for $(uname -s); build it with: go install github.com/migueww/izumo/cmd/izumo@latest" >&2; exit 1;;
esac
case $(uname -m) in
  x86_64|amd64) arch=amd64;;
  arm64|aarch64) arch=arm64;;
  *) echo "izumo: no build for $(uname -m); build it with: go install github.com/migueww/izumo/cmd/izumo@latest" >&2; exit 1;;
esac
name=izumo_${os}_$arch
if [ $os = windows ]; then name=$name.exe; fi
bin=${IZUMO_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/izumo}/$VERSION/$name

if [ ! -f "$bin" ]; then
  # the Claude Code hooks fire on every prompt: they never download, and say nothing
  if [ "${1:-}" = _agent ]; then exit 0; fi
  echo "izumo: downloading izumo $VERSION for $os/$arch (once)" >&2
  dir=$(dirname "$bin")
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.download.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  curl -fsSL "$RELEASES/v$VERSION/$name" -o "$tmp" ||
    { echo "izumo: download failed: $RELEASES/v$VERSION/$name" >&2; exit 1; }
  want=$(curl -fsSL "$RELEASES/v$VERSION/checksums.txt" | awk -v n="$name" '$2 == n || $2 == "*" n {print $1}')
  # from stdin: sha256sum marks names holding a backslash (Windows paths) with a leading \
  if command -v sha256sum >/dev/null; then got=$(sha256sum < "$tmp"); else got=$(shasum -a 256 < "$tmp"); fi
  if [ -z "$want" ] || [ "${got%% *}" != "$want" ]; then
    echo "izumo: $name does not match the release's checksums.txt; not running it" >&2
    exit 1
  fi
  chmod +x "$tmp"
  mv -f "$tmp" "$bin"
fi
exec "$bin" "$@"
