#!/usr/bin/env bash
# izumo: one folder per task, one git worktree per repo.
# https://github.com/migueww/izumo (MIT)
set -euo pipefail

VERSION=0.5.0
GH=${IZUMO_GH:-gh}

say() { echo "izumo: $*" >&2; }
die() { say "$@"; exit 1; }

usage() {
  cat <<'EOF'
izumo: one folder per task, one git worktree per repo

  izumo                                    same as izumo ls
  izumo new <task> [repo...] [--branch B] [--base BRANCH]
  izumo add <repo...> [--task T]
  izumo drop <repo...> [--task T]          take repos out of a task, keeping the task
  izumo adopt <worktree...> [--task T]     move existing worktrees into a task
  izumo mv <task> <new-name>               rename a task (branches keep their names)
  izumo base <branch> [--task T]           change the branch a task is based on
  izumo ls [task...] [--json] [--fetch]
  izumo done [task...] [--dry-run]
  izumo rm <task...> [--dry-run]

Run it anywhere under your multi-repo root, the folder holding a .izumo file.
EOF
}

valid_name() {
  case $1 in ''|.*|*[!A-Za-z0-9._-]*) die "invalid name: '$1'";; esac
}

find_root() {
  local d
  d=$(pwd -P)
  while [ ! -f "$d/.izumo" ]; do
    [ "$d" != / ] || die "no .izumo above $(pwd); create one at your multi-repo root: touch .izumo"
    d=$(dirname "$d")
  done
  echo "$d"
}

json_str() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\t'/\\t}; s=${s//$'\r'/}; s=${s//$'\n'/\\n}
  printf '"%s"' "$s"
}

is_ancestor() { git -C "$1" merge-base --is-ancestor "$2" "$3" 2>/dev/null; }

# Claude Code hook (hooks/hooks.json): record what the agent in this task is doing.
# Fires in every session, so it stays cheap, silent and exits 0 outside a task.
agent_hook() {
  local state=${1:-} start d
  case $state in working|waiting|done|end) ;; *) return 0;; esac
  for start in "$PWD" "${CLAUDE_PROJECT_DIR:-}"; do
    d=$(cd "$start" 2>/dev/null && pwd -P) || continue
    while [ "$d" != / ] && [ "$d" != . ]; do
      if [ -f "$d/.task" ] && [ -f "$(dirname "$(dirname "$d")")/.izumo" ]; then
        if [ "$state" = end ]; then
          rm -f "$d/.agent" 2>/dev/null || true
        else
          { printf '%s %s\n' "$state" "$(date +%s)" > "$d/.agent"; } 2>/dev/null || true
        fi
        return 0
      fi
      d=$(dirname "$d")
    done
  done
}

# origin/<branch> work starts from: task --base, else BASE, else origin's default branch.
# A repo without that branch on origin (mixed roots) falls back to its default branch.
base_ref() {
  local b=${2:-$BASE}
  if [ -n "$b" ] && git -C "$1" show-ref --verify --quiet "refs/remotes/origin/$b"; then
    echo "origin/$b"; return
  fi
  git -C "$1" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null ||
    die "$(basename "$1"): origin/HEAD unknown; set BASE in .izumo or run: git -C '$1' remote set-head origin -a"
}

prod_ref() {
  if [ -n "$PROD" ] && git -C "$1" show-ref --verify --quiet "refs/remotes/origin/$PROD"; then
    echo "origin/$PROD"
  else
    base_ref "$@"
  fi
}

load_task() {
  valid_name "$1"
  [ -f "$TASKS/$1/.task" ] || die "no task '$1'"
  T_BRANCH= T_BASE=
  . "$TASKS/$1/.task"
}

cwd_task() {
  local p
  p=$(pwd -P)/
  case $p in "$TASKS"/?*/*) p=${p#"$TASKS"/}; echo "${p%%/*}";; *) return 1;; esac
}

all_tasks() {
  local d
  for d in "$TASKS"/*/; do
    if [ -f "$d.task" ]; then basename "$d"; fi
  done
}

worktrees() {
  local d
  for d in "$TASKS/$1"/*/; do
    if [ -f "$d.git" ]; then basename "$d"; fi
  done
}

write_workspace() {
  local dir=$TASKS/$1 r sep=
  {
    printf '{\n  "folders": ['
    for r in $(worktrees "$1"); do
      printf '%s\n    { "name": %s, "path": %s }' "$sep" \
        "$(json_str "$r ($(git -C "$dir/$r" branch --show-current))")" "$(json_str "$r")"
      sep=,
    done
    printf '\n  ]\n}\n'
  } > "$dir/$1.code-workspace"
}

write_task_files() {
  local dir=$TASKS/$1
  if [ -n "$TASK_TEMPLATE" ]; then
    sed "s/{{task}}/$1/g" "$TASK_TEMPLATE" > "$dir/TASK.md"
  else
    printf '# %s\n\n## Goal\n\n## Status / next step\n\n## Decisions\n\n## Open items\n' "$1" > "$dir/TASK.md"
  fi
  cat > "$dir/AGENTS.md" <<'EOF'
This folder is an izumo task: each subfolder is a git worktree of one repo, all on
the task's branch. Read TASK.md first and keep it current. It holds only what git
can't tell: goal, status / next step, decisions and open items. Repos, branches and
PR state come from `izumo ls <task>`, so never write them here: the next step is the
next thing a person does. Need another repo? Run `izumo add <repo>` from here;
one no longer needed? `izumo drop <repo>`.
EOF
  printf '@AGENTS.md\n@TASK.md\n' > "$dir/CLAUDE.md"
}

save_task() { printf 'T_BRANCH=%q\nT_BASE=%q\n' "$2" "$3" > "$TASKS/$1/.task"; }

# create_task <task> <branch> <base>
create_task() {
  [ -e "$TASKS/$1" ] && die "task '$1' already exists"
  [ -z "$TASK_TEMPLATE" ] || [ -f "$TASK_TEMPLATE" ] || die "TASK_TEMPLATE not found: $TASK_TEMPLATE"
  git check-ref-format --branch "$2" >/dev/null 2>&1 || die "invalid branch name: $2"
  mkdir -p "$TASKS/$1"
  save_task "$@"
  write_task_files "$1"
  write_workspace "$1"
}

add_repos() {
  local task=$1 repo src wt ref
  shift
  load_task "$task"
  for repo; do
    valid_name "$repo"
    src=$ROOT/$repo wt=$TASKS/$task/$repo
    [ -d "$src/.git" ] || die "$repo: no git clone at $src"
    [ -e "$wt" ] && die "$repo is already in task '$task'"
    git -C "$src" fetch --quiet origin || say "$repo: fetch failed, using local refs"
    if git -C "$src" show-ref --verify --quiet "refs/heads/$T_BRANCH" ||
       git -C "$src" show-ref --verify --quiet "refs/remotes/origin/$T_BRANCH"; then
      # existing branch, local or on origin (git creates the tracking branch)
      git -C "$src" worktree add --quiet "$wt" "$T_BRANCH"
    else
      ref=$(base_ref "$src" "$T_BASE")
      git -C "$src" rev-parse --verify --quiet "$ref^{commit}" >/dev/null || die "$repo: no $ref"
      git -C "$src" worktree add --quiet --no-track -b "$T_BRANCH" "$wt" "$ref"
    fi
    write_workspace "$task"
    ( cd "$wt" && export TASK=$task REPO=$repo SRC=$src WT=$wt BRANCH=$T_BRANCH && post_add ) ||
      say "$repo: post_add hook failed (worktree kept)"
    echo "$wt"
  done
}

# one TSV line per PR: url state mergeCommit head review ci, "-" for empty fields (IFS tab collapses them)
PR_JQ='.[0] // empty | (.statusCheckRollup // []) as $c | [
  .url, .state, (.mergeCommit.oid // "-"), .headRefOid,
  (if (.reviewDecision // "") == "" then "-" else .reviewDecision end),
  (if ($c | length) == 0 then "-"
   elif any($c[]; (.conclusion // .state // "") | test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE")) then "failing"
   elif any($c[]; (.status // "COMPLETED") != "COMPLETED" or (.state // "") == "PENDING" or (.state // "") == "EXPECTED") then "running"
   else "passing" end)
] | @tsv'

# sets R_BRANCH R_DIRTY R_MODIFIED R_UNTRACKED R_UNPUSHED R_PR R_REVIEW R_CI
# and R_STAGE: empty|wip|pr|base|prod|detached
repo_state() {
  local wt=$TASKS/$1/$2 src=$ROOT/$2 head created base prod line state merge headref review ci
  R_BRANCH=$(git -C "$wt" branch --show-current) R_PR= R_REVIEW= R_CI=
  read -r R_MODIFIED R_UNTRACKED <<<"$(git -C "$wt" status --porcelain | awk '/^\?\?/ {u++; next} {m++} END {print m + 0, u + 0}')"
  R_DIRTY=false
  if [ $((R_MODIFIED + R_UNTRACKED)) -gt 0 ]; then R_DIRTY=true; fi
  head=$(git -C "$wt" rev-parse HEAD)
  R_UNPUSHED=$(git -C "$wt" rev-list --count HEAD --not --remotes)
  if [ -z "$R_BRANCH" ]; then R_STAGE=detached; return; fi
  # oldest reflog entry = where the branch started; still there means no work on it
  created=$(git -C "$wt" log -g --format=%H "refs/heads/$R_BRANCH" 2>/dev/null | tail -1)
  base=$(base_ref "$src" "$T_BASE")
  prod=$(prod_ref "$src" "$T_BASE")
  if [ "$head" = "$created" ]; then R_STAGE=empty
  elif is_ancestor "$wt" "$head" "$prod"; then R_STAGE=prod
  elif is_ancestor "$wt" "$head" "$base"; then R_STAGE=base
  else R_STAGE=wip
  fi
  case $R_STAGE in empty|prod) return;; esac
  command -v "$GH" >/dev/null || return 0
  line=$(cd "$wt" && "$GH" pr list --head "$R_BRANCH" --state all --limit 1 \
    --json url,state,mergeCommit,headRefOid,reviewDecision,statusCheckRollup --jq "$PR_JQ" 2>/dev/null) || return 0
  [ -n "$line" ] || return 0
  IFS=$'\t' read -r R_PR state merge headref review ci <<<"$line"
  case $state in
    OPEN)
      R_STAGE=pr
      case $review in
        APPROVED) R_REVIEW=approved;;
        CHANGES_REQUESTED) R_REVIEW=changes-requested;;
        REVIEW_REQUIRED) R_REVIEW=review-required;;
      esac
      if [ "$ci" != - ]; then R_CI=$ci; fi;;
    MERGED)
      R_STAGE=base
      if is_ancestor "$wt" "$merge" "$prod"; then R_STAGE=prod; fi
      # squash merge: the branch commits live on in the PR, so nothing is lost
      if [ "$headref" = "$head" ]; then R_UNPUSHED=0; fi;;
  esac
}

goal() {
  # the first section of TASK.md is the goal, whatever its heading
  awk '/^## /{n++; next} n == 1 && NF {print; exit} n > 1 {exit}' "$TASKS/$1/TASK.md" 2>/dev/null || true
}

# sets A_STATE A_SINCE from the hook's file, empty when no agent recorded
agent_of() {
  A_STATE= A_SINCE=
  [ -f "$TASKS/$1/.agent" ] || return 0
  read -r A_STATE A_SINCE < "$TASKS/$1/.agent" || true
  case $A_SINCE in ''|*[!0-9]*) A_STATE= A_SINCE=;; esac
}

ago() {
  local s=$(( $(date +%s) - $1 ))
  if [ $s -lt 60 ]; then echo "${s}s"; elif [ $s -lt 3600 ]; then echo "$((s / 60))m"; else echo "$((s / 3600))h"; fi
}

cmd_new() {
  local task= branch= base= repos=()
  while [ $# -gt 0 ]; do
    case $1 in
      --branch) branch=${2:?--branch needs a value}; shift 2; continue;;
      --base) base=${2:?--base needs a value}; shift 2; continue;;
      -*) die "unknown flag $1";;
      *) if [ -z "$task" ]; then task=$1; else repos+=("$1"); fi;;
    esac
    shift
  done
  [ -n "$task" ] || die "usage: izumo new <task> [repo...] [--branch B] [--base BRANCH]"
  valid_name "$task"
  create_task "$task" "${branch:-$PREFIX$task}" "$base"
  if [ ${#repos[@]} -gt 0 ]; then add_repos "$task" "${repos[@]}" >/dev/null; fi
  echo "$TASKS/$task"
}

cmd_add() {
  local task= repos=()
  while [ $# -gt 0 ]; do
    case $1 in
      --task) task=${2:?--task needs a value}; shift 2; continue;;
      -*) die "unknown flag $1";;
      *) repos+=("$1");;
    esac
    shift
  done
  [ ${#repos[@]} -gt 0 ] || die "usage: izumo add <repo...> [--task T]"
  [ -n "$task" ] || task=$(cwd_task) || die "not inside a task folder; pass --task"
  add_repos "$task" "${repos[@]}"
}

# moves worktrees made by hand (or by another tool) into a task, creating it if needed
cmd_adopt() {
  local task= paths=() p abs src repo dest br from
  while [ $# -gt 0 ]; do
    case $1 in
      --task) task=${2:?--task needs a value}; shift 2; continue;;
      -*) die "unknown flag $1";;
      *) paths+=("$1");;
    esac
    shift
  done
  [ ${#paths[@]} -gt 0 ] || die "usage: izumo adopt <worktree...> [--task T]"
  [ -n "$task" ] || task=$(cwd_task) || die "not inside a task folder; pass --task"
  valid_name "$task"
  for p in "${paths[@]}"; do
    abs=$(cd "$p" 2>/dev/null && pwd -P) || die "$p: no such folder"
    [ -f "$abs/.git" ] || die "$p: not a git worktree"
    case "$(pwd -P)/" in "$abs"/*) die "$p: you are inside it, cd out first";; esac
    src=$(cd "$abs" && cd "$(git rev-parse --git-common-dir)/.." && pwd -P) || die "$p: can't find its repo"
    [ "$(dirname "$src")" = "$ROOT" ] || die "$p: its repo $src is not a clone in $ROOT"
    repo=$(basename "$src")
    case $abs in "$TASKS"/*/*) from=${abs#"$TASKS"/}; from=${from%%/*};; *) from=;; esac
    if [ ! -f "$TASKS/$task/.task" ]; then
      br=$(git -C "$abs" branch --show-current)
      create_task "$task" "${br:-$PREFIX$task}" ""
    fi
    dest=$TASKS/$task/$repo
    [ -e "$dest" ] && die "$repo is already in task '$task'"
    git -C "$src" worktree move "$abs" "$dest" || die "$p: git could not move it (locked or has submodules?)"
    write_workspace "$task"
    # it came from another task: that one's workspace must stop listing it
    if [ -n "$from" ] && [ -f "$TASKS/$from/.task" ]; then write_workspace "$from"; fi
    echo "$dest"
  done
}

# mv: renames a task; branches keep their names, since they may have PRs open
cmd_mv() {
  [ $# -eq 2 ] || die "usage: izumo mv <task> <new-name>"
  local old=$1 new=$2 dir=$TASKS/$1 r
  load_task "$old"
  valid_name "$new"
  [ ! -e "$TASKS/$new" ] || die "task '$new' already exists"
  [ ! -f "$dir/.removing" ] || die "$old: a removal stopped halfway; finish it with izumo rm $old"
  case "$(pwd -P)/" in "$dir"/*) die "$old: you are inside it, cd out first";; esac
  if in_use "$dir"; then die "$old: kept ($IN_USE)"; fi
  mv "$dir" "$TASKS/$new" || die "$old: could not rename the folder"
  dir=$TASKS/$new
  # the worktrees moved under git's feet; repair points each repo at the new path
  for r in $(worktrees "$new"); do
    git -C "$ROOT/$r" worktree repair "$dir/$r" >/dev/null 2>&1 ||
      die "$r: git lost track of the worktree; run: git -C '$ROOT/$r' worktree repair '$dir/$r'"
  done
  rm -f "$dir/$old.code-workspace"
  write_workspace "$new"
  # the default TASK.md and most templates start with the task name as heading
  if [ "$(head -1 "$dir/TASK.md" 2>/dev/null)" = "# $old" ]; then
    { echo "# $new"; tail -n +2 "$dir/TASK.md"; } > "$dir/.TASK.md.tmp" && mv "$dir/.TASK.md.tmp" "$dir/TASK.md"
  fi
  echo "$dir"
}

# base: changes the branch a task's new repos start from and its stages compare against.
# Existing worktrees stay where they are: rebasing them is git's job.
cmd_base() {
  local task= branch= r
  while [ $# -gt 0 ]; do
    case $1 in
      --task) task=${2:?--task needs a value}; shift 2; continue;;
      -*) die "unknown flag $1";;
      *) [ -z "$branch" ] || die "usage: izumo base <branch> [--task T]"; branch=$1;;
    esac
    shift
  done
  [ -n "$branch" ] || die "usage: izumo base <branch> [--task T]"
  [ -n "$task" ] || task=$(cwd_task) || die "not inside a task folder; pass --task"
  load_task "$task"
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "invalid branch name: $branch"
  save_task "$task" "$T_BRANCH" "$branch"
  for r in $(worktrees "$task"); do
    git -C "$ROOT/$r" show-ref --verify --quiet "refs/remotes/origin/$branch" ||
      say "$r: no origin/$branch, uses $(base_ref "$ROOT/$r" "$branch")"
  done
  echo "$task: base $branch"
}

cmd_ls() {
  local json=false fetch=false tasks=() t r n=0 tmp seen=' ' tsep= rsep= flags removing lines shipped ready
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=true;;
      --fetch) fetch=true;;
      -*) die "unknown flag $1";;
      *) tasks+=("$1");;
    esac
    shift
  done
  [ ${#tasks[@]} -gt 0 ] || tasks=($(all_tasks))
  for t in ${tasks[@]+"${tasks[@]}"}; do load_task "$t"; done

  if $fetch; then
    for t in ${tasks[@]+"${tasks[@]}"}; do
      for r in $(worktrees "$t"); do
        case $seen in *" $r "*) continue;; esac
        seen="$seen$r "
        ( git -C "$ROOT/$r" fetch --quiet origin 2>/dev/null || say "$r: fetch failed, using local refs" ) &
      done
    done
    wait
  fi

  # each repo costs a few git calls and maybe a gh API call: run them 8 at a time
  tmp=$(mktemp -d)
  trap "rm -rf '$tmp'" EXIT  # expanded now: $tmp is local and gone by exit
  for t in ${tasks[@]+"${tasks[@]}"}; do
    mkdir -p "$tmp/$t"
    for r in $(worktrees "$t"); do
      ( load_task "$t" && repo_state "$t" "$r" &&
        printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$R_BRANCH" "$R_STAGE" "$R_MODIFIED" \
          "$R_UNTRACKED" "$R_UNPUSHED" "$R_PR" "$R_REVIEW" "$R_CI" > "$tmp/$t/$r" ) &
      n=$((n + 1))
      if [ $((n % 8)) -eq 0 ]; then wait; fi
    done
  done
  wait

  if $json; then printf '['; fi
  for t in ${tasks[@]+"${tasks[@]}"}; do
    agent_of "$t"
    removing=false
    if [ -f "$TASKS/$t/.removing" ]; then removing=true; fi
    # repos first: the header says whether done would take the task
    lines= rsep= shipped=false ready=true
    for r in $(worktrees "$t"); do
      R_BRANCH=? R_STAGE=error R_MODIFIED=0 R_UNTRACKED=0 R_UNPUSHED=0 R_PR= R_REVIEW= R_CI=
      if [ -f "$tmp/$t/$r" ]; then
        IFS=$'\037' read -r R_BRANCH R_STAGE R_MODIFIED R_UNTRACKED R_UNPUSHED R_PR R_REVIEW R_CI < "$tmp/$t/$r"
      fi
      case $R_STAGE in prod) shipped=true;; empty) ;; *) ready=false;; esac
      if [ $((R_MODIFIED + R_UNTRACKED + R_UNPUSHED)) -gt 0 ]; then ready=false; fi
      if $json; then
        R_DIRTY=false
        if [ $((R_MODIFIED + R_UNTRACKED)) -gt 0 ]; then R_DIRTY=true; fi
        lines="$lines$rsep$(printf '\n    { "repo": %s, "branch": %s, "stage": "%s", "dirty": %s, "modified": %s, "untracked": %s, "unpushed": %s, "pr": %s, "review": %s, "ci": %s }' \
          "$(json_str "$r")" "$(json_str "$R_BRANCH")" "$R_STAGE" "$R_DIRTY" "$R_MODIFIED" "$R_UNTRACKED" \
          "$R_UNPUSHED" "$(json_str "$R_PR")" "$(json_str "$R_REVIEW")" "$(json_str "$R_CI")")"
        rsep=,
      else
        flags=
        if [ "$R_MODIFIED" -gt 0 ]; then flags="$flags $R_MODIFIED-modified"; fi
        if [ "$R_UNTRACKED" -gt 0 ]; then flags="$flags $R_UNTRACKED-untracked"; fi
        if [ "$R_UNPUSHED" -gt 0 ]; then flags="$flags $R_UNPUSHED-unpushed"; fi
        if [ -n "$R_REVIEW" ]; then flags="$flags $R_REVIEW"; fi
        if [ -n "$R_CI" ]; then flags="$flags ci:$R_CI"; fi
        lines="$lines$(printf '  %-32s %-36s %-6s%s %s' "$r" "$R_BRANCH" "$R_STAGE" "$flags" "$R_PR")"$'\n'
      fi
    done
    if ! $shipped || $removing; then ready=false; fi
    if $json; then
      printf '%s\n  { "task": %s, "path": %s, "goal": %s, "ready": %s, "removing": %s, "agent": ' \
        "$tsep" "$(json_str "$t")" "$(json_str "$TASKS/$t")" "$(json_str "$(goal "$t")")" "$ready" "$removing"
      if [ -n "$A_STATE" ]; then printf '{ "state": %s, "since": %s }' "$(json_str "$A_STATE")" "$A_SINCE"; else printf null; fi
      printf ', "repos": [%s\n  ] }' "$lines"
      tsep=,
    else
      printf '%s' "$t"
      if $ready; then printf '  [ready: izumo done]'; fi
      if [ -n "$A_STATE" ]; then printf '  [agent %s %s]' "$A_STATE" "$(ago "$A_SINCE")"; fi
      if $removing; then printf '  [removal stopped halfway: izumo rm %s]' "$t"; fi
      printf '  %s\n%s' "$(goal "$t")" "$lines"
    fi
  done
  if $json; then printf '\n]\n'; fi
}

# in_removing <task> <name>: was <name> listed when this task's removal started?
in_removing() {
  awk -v r="$2" '$1 == r {found = 1} END {exit !found}' "$TASKS/$1/.removing"
}

IN_USE="a program has the folder open (VS Code, a terminal, a dev server?), close it"

# Windows won't delete a folder a program has open, and git finds out halfway through; a rename
# fails in the same cases, so try one while nothing is removed yet
in_use() {
  local tmp
  tmp=$(dirname "$1")/.$(basename "$1").izumo-check
  case $(uname -s) in MINGW*|MSYS*|CYGWIN*) ;; *) return 1;; esac
  mv -T "$1" "$tmp" 2>/dev/null || return 0
  mv -T "$tmp" "$1" || die "could not rename $tmp back to $1"
  return 1
}

# drop: takes repos out of a task when nothing would be lost; the task stays
cmd_drop() {
  local task= repos=() r wt
  while [ $# -gt 0 ]; do
    case $1 in
      --task) task=${2:?--task needs a value}; shift 2; continue;;
      -*) die "unknown flag $1";;
      *) repos+=("$1");;
    esac
    shift
  done
  [ ${#repos[@]} -gt 0 ] || die "usage: izumo drop <repo...> [--task T]"
  [ -n "$task" ] || task=$(cwd_task) || die "not inside a task folder; pass --task"
  load_task "$task"
  for r in "${repos[@]}"; do
    valid_name "$r"
    wt=$TASKS/$task/$r
    [ -f "$wt/.git" ] || die "$r is not in task '$task'"
    case "$(pwd -P)/" in "$wt"/*) die "$r: you are inside it, cd out first";; esac
    git -C "$ROOT/$r" fetch --quiet origin 2>/dev/null || say "$r: fetch failed, using local refs"
    repo_state "$task" "$r"
    if $R_DIRTY; then die "$r: kept (uncommitted changes: $R_MODIFIED modified, $R_UNTRACKED untracked)"; fi
    if [ "$R_UNPUSHED" -gt 0 ]; then die "$r: kept ($R_UNPUSHED unpushed commit(s))"; fi
    if in_use "$wt"; then die "$r: kept ($IN_USE)"; fi
    git -c core.longpaths=true -C "$ROOT/$r" worktree remove "$wt" ||
      die "$r: could not remove the worktree (a program has it open?)"
    git -C "$ROOT/$r" worktree prune
    # every commit is on a remote or in a merged PR, so the local branch holds nothing of its own
    if [ -n "$R_BRANCH" ]; then git -C "$ROOT/$r" branch -D -q "$R_BRANCH" || say "$r: could not delete branch $R_BRANCH"; fi
    write_workspace "$task"
    echo "dropped $r from $task"
  done
}

# done: every repo in prod (or untouched) and nothing would be lost. rm: nothing would be lost.
remove_task() {
  local mode=$1 dry=$2 t=$3 dir=$TASKS/$3 r f br why= shipped=false resuming=false
  load_task "$t"
  # an earlier removal stopped halfway: its checks passed back then, so finish what it listed
  if [ -f "$dir/.removing" ]; then resuming=true mode=rm; fi
  for r in $(worktrees "$t"); do
    git -C "$ROOT/$r" fetch --quiet origin 2>/dev/null || say "$r: fetch failed, using local refs"
    repo_state "$t" "$r"
    if $R_DIRTY; then why="$why; $r has uncommitted changes ($R_MODIFIED modified, $R_UNTRACKED untracked)"; fi
    if [ "$R_UNPUSHED" -gt 0 ]; then why="$why; $r has $R_UNPUSHED unpushed commit(s)"; fi
    if [ "$mode" = done ]; then
      case $R_STAGE in
        prod) shipped=true;;
        empty) ;;
        *) why="$why; $r is not in prod ($R_STAGE)";;
      esac
    fi
  done
  if [ "$mode" = done ] && ! $shipped && [ -z "$why" ]; then why="; nothing reached prod"; fi
  # Windows locks a shell's cwd, so removal would stop halfway; elsewhere the shell is left in a deleted dir
  case "$(pwd -P)/" in "$dir"/*) why="$why; you are inside it, cd out first";; esac
  for f in "$dir"/* "$dir"/.[!.]*; do
    [ -e "$f" ] || continue
    f=$(basename "$f")
    case $f in .task|.agent|.removing|TASK.md|AGENTS.md|CLAUDE.md|"$t.code-workspace") continue;; esac
    [ -f "$dir/$f/.git" ] && continue
    if $resuming && in_removing "$t" "$f"; then continue; fi
    why="$why; unknown file $f"
  done
  if [ -z "$why" ] && in_use "$dir"; then why="; $IN_USE"; fi
  if [ -n "$why" ]; then say "$t: kept (${why#; })"; return 1; fi
  if $dry; then echo "would remove $t"; return 0; fi

  # set -e is off in here (we run under ||), so every step checks itself
  if ! $resuming; then
    if [ -f "$dir/TASK.md" ]; then
      { mkdir -p "$TASKS/.archive" && cp "$dir/TASK.md" "$TASKS/.archive/$(date +%Y-%m-%d)-$t.md"; } ||
        die "$t: could not archive TASK.md; nothing removed"
    fi
    for r in $(worktrees "$t"); do
      printf '%s %s\n' "$r" "$(git -C "$dir/$r" branch --show-current)"
    done > "$dir/.removing" || die "$t: could not write $dir/.removing; nothing removed"
  fi
  while read -r r br <&3; do
    valid_name "$r"
    if [ -f "$dir/$r/.git" ]; then
      # longpaths: deep node_modules otherwise stop the removal halfway on Windows
      git -c core.longpaths=true -C "$ROOT/$r" worktree remove "$dir/$r" ||
        die "$t: could not remove worktree $r (a program has it open?); fix that and run the same command to finish"
    elif [ -e "$dir/$r" ]; then
      rm -rf "${dir:?}/$r" || die "$t: could not remove what is left of $r (a program has it open?); fix that and run the same command to finish"
    fi
    git -C "$ROOT/$r" worktree prune
    if [ -n "$br" ] && git -C "$ROOT/$r" show-ref --verify --quiet "refs/heads/$br"; then
      git -C "$ROOT/$r" branch -D -q "$br" || say "$r: could not delete branch $br"
    fi
  done 3< "$dir/.removing"
  rm -rf "${dir:?}" || die "$t: worktrees and branches are gone, but the folder is in use; delete $dir once nothing has it open"
  echo "removed $t"
}

cmd_remove() {
  local mode=$1 dry=false tasks=() t kept=0 named=true
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) dry=true;;
      -*) die "unknown flag $1";;
      *) tasks+=("$1");;
    esac
    shift
  done
  if [ ${#tasks[@]} -eq 0 ]; then
    [ "$mode" = done ] || die "usage: izumo rm <task...> [--dry-run]"
    named=false
    tasks=($(all_tasks))
  fi
  for t in ${tasks[@]+"${tasks[@]}"}; do
    remove_task "$mode" "$dry" "$t" || kept=1
  done
  if $named; then return $kept; fi
}

cmd=${1:-}
case $cmd in
  new|add|drop|adopt|mv|base|ls|done|rm) shift;;
  _agent) shift; agent_hook "$@"; exit 0;;
  '')
    if [ -z "${IZUMO_ROOT:-}" ] && ! (find_root) >/dev/null 2>&1; then usage; exit; fi
    cmd=ls;;
  --version) echo "izumo $VERSION"; exit;;
  -h|--help|help) usage; exit;;
  *) usage >&2; exit 2;;
esac

ROOT=${IZUMO_ROOT:-$(find_root)}
ROOT=$(cd "$ROOT" && pwd -P)
[ -f "$ROOT/.izumo" ] || die "no .izumo in $ROOT"
TASKS=$ROOT/tasks
BASE= PROD= PREFIX= TASK_TEMPLATE=
post_add() { :; }
# .izumo is sourced as bash: trust it like a Makefile
. "$ROOT/.izumo"
case $TASK_TEMPLATE in ''|/*|[A-Za-z]:*) ;; *) TASK_TEMPLATE=$ROOT/$TASK_TEMPLATE;; esac

case $cmd in
  new) cmd_new "$@";;
  add) cmd_add "$@";;
  drop) cmd_drop "$@";;
  adopt) cmd_adopt "$@";;
  mv) cmd_mv "$@";;
  base) cmd_base "$@";;
  ls) cmd_ls "$@";;
  done|rm) cmd_remove "$cmd" "$@";;
esac
